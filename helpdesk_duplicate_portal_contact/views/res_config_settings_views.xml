<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="helpdesk_mgmt.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='helpdesk_mgmt']/block[last()]" position="after">
                    <block title="Portal User Creation">
                        <setting>
                            <field name="helpdesk_on_duplicate" />
                        </setting>

                        <setting>
                            <label for="helpdesk_on_duplicate" />
                            <div class="text-muted">Create helpdesk ticket on new portal user if a contact with the same name already exists</div>
                            <br/>
                            <label for="helpdesk_team_id" />
                            <field name="helpdesk_team_id" class="oe_inline" />
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>